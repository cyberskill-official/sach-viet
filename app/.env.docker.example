# Local Docker Compose env for app/docker-compose.yml.
# Copy to app/.env.docker (gitignored) and fill values. Do not commit secrets.
# Field names align with app/web/.env.example. See web/OPERATIONS.md (Local Docker).

# Session signing secret (min 32 characters). Required for auth cookies.
# Generate with: openssl rand -hex 32
AUTH_SESSION_SECRET=

# First-admin bootstrap (all three required with DATABASE_PATH; only when the user store is empty).
# Generate hash from app/web: printf '%s' 'your-password' | npm run hash-password
# Compose interpolates env_file values: escape every `$` in the hash as `$$`
# (e.g. scrypt$salt$digest → scrypt$$salt$$digest). Runtime sees single `$`.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD_HASH=

# Optional. Unset = stubs / local defaults (not required for a local smoke login).
# STRIPE_WEBHOOK_SECRET=
# SMTP_HOST=
# SMTP_FROM=
# SMTP_PASSWORD=
# ZALO_OA_ACCESS_TOKEN=
# MEILI_HOST=
# MEILI_API_KEY=

# Local seed profile only (docker compose --profile seed). Never for CapRover production.
# SEED_PASSWORD=
