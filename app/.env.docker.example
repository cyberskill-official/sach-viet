# Local Docker Compose env for app/docker-compose.yml.
# Copy to app/.env.docker (gitignored) and fill values. Do not commit secrets.
# Field names align with app/web/.env.example. See web/OPERATIONS.md (Local Docker).

# Session signing secret (min 32 characters). Required for auth cookies.
# Generate with: openssl rand -hex 32
AUTH_SESSION_SECRET=

# First-admin bootstrap (required with DATABASE_URL; only when the user store is empty).
# Generate hash from app/web: printf '%s' 'your-password' | npm run hash-password
# Compose interpolates env_file values: escape every `$` in the hash as `$$`
# (e.g. scrypt$salt$digest → scrypt$$salt$$digest). Runtime sees single `$`.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD_HASH=

# Compose sets DATABASE_URL to the internal `db` service. Override only if needed.
# DATABASE_URL=postgres://sachviet:sachviet@db:5432/sachviet

# Optional Stripe test-mode path for local paid checkout.
# All three checkout vars required; webhook secret required for signed /api/webhooks/stripe.
# STRIPE_SECRET_KEY=
# STRIPE_SUCCESS_URL=http://127.0.0.1:3000/ecom/orders
# STRIPE_CANCEL_URL=http://127.0.0.1:3000/
# STRIPE_WEBHOOK_SECRET=

# Optional. Unset = stubs / local defaults (not required for a local smoke login).
# SMTP_HOST=
# SMTP_FROM=
# SMTP_PASSWORD=
# ZALO_OA_ACCESS_TOKEN=
# MEILI_HOST=
# MEILI_API_KEY=

# Local seed profile only (docker compose --profile seed). Never for CapRover/Vercel production.
# Local seed only. Prefer setting this so the password is never printed or written.
# If unset, seed writes app/web/.seed-password (mode 0600). Never set in production.
# SEED_PASSWORD=

# Admin BYOK AI (Wave 3). Min 32 characters. Encrypts API keys stored via /admin AI panel.
# Generate with: openssl rand -hex 32
# Unset = playground/save fail closed with a clear error.
# AI_SETTINGS_SECRET=
