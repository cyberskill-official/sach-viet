# Vercel + Supabase cloud — environment names only. Do not put real secrets here.
# Copy names into the Vercel project Environment Variables UI (Preview / Production).
# Full operator steps: docs/deploy-vercel-supabase.md and app/web/OPERATIONS.md.

# --- Required (Preview and Production) ---
# Session signing secret (min 32 characters).
AUTH_SESSION_SECRET=

# Supabase Postgres. Prefer the pooler URL for the Next.js runtime on Vercel.
# Use a direct (non-pooler) URL when running migrations from a laptop/CI job.
# Example shape only (replace project ref / password):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=

# --- First-admin bootstrap (optional; only when the user store is empty) ---
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD_HASH=

# --- Stripe (test mode for Preview; live keys only with explicit operator go) ---
STRIPE_SECRET_KEY=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
STRIPE_WEBHOOK_SECRET=

# --- Admin BYOK AI (optional on Preview; required to save/use keys) ---
# Min 32 characters. Generate: openssl rand -hex 32
AI_SETTINGS_SECRET=

# --- Optional integrations (unset = recording stubs / local defaults) ---
# SMTP_HOST=
# SMTP_FROM=
# SMTP_PASSWORD=
# ZALO_OA_ACCESS_TOKEN=
# MEILI_HOST=
# MEILI_API_KEY=

# Never set on Vercel Preview or Production:
# SEED_PASSWORD=
# DATABASE_PATH=
