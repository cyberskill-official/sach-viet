# Vercel + Supabase cloud — environment names only. Do not put real secrets here.
# Copy names into the Vercel project Environment Variables UI (Preview / Production).
# Full operator steps: docs/deploy-vercel-supabase.md and app/web/OPERATIONS.md.

# --- Required (Preview and Production) ---
# Session signing secret (min 32 characters).
AUTH_SESSION_SECRET=

# Supabase Postgres. Prefer the pooler URL for the Next.js runtime on Vercel.
# Use a direct (non-pooler) URL when running migrations from a laptop/CI job.
# Example shape only (replace project ref / password):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=

# --- First-admin bootstrap (optional; only when the user store is empty) ---
# Prefer plain ADMIN_* (hashed at runtime). Setting these does NOT reset an
# existing admin password — bootstrap runs only when the user store is empty.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Operator recovery when users already exist (set to 1, redeploy, log in once, then unset):
# ADMIN_EMAIL_SYNC=1
# ADMIN_PASSWORD_SYNC=1
# Fallback (existing Vercel wiring): pre-hashed password via npm run hash-password
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD_HASH=

# --- Stripe (sandbox/test on Production for TASK-PAYMENTS-001) ---
# Use sk_test_… only. Helpers refuse sk_live_. Hosted Checkout does not need publishable key.
# STRIPE_SECRET_KEY=
# STRIPE_SUCCESS_URL=https://sachviet.cyberskill.world/ecom/orders?paid=1
# STRIPE_CANCEL_URL=https://sachviet.cyberskill.world/ecom/cart
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PUBLISHABLE_KEY=

# --- PayPal Orders sandbox (TASK-PAYMENTS-001) ---
# PAYPAL_MODE must be sandbox (live refused).
# PAYPAL_MODE=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_RETURN_URL=https://sachviet.cyberskill.world/api/checkout/paypal/return
# PAYPAL_CANCEL_URL=https://sachviet.cyberskill.world/ecom/cart
# PAYPAL_WEBHOOK_ID=

# --- Admin AI (retired on Production: routes return 410) ---
# Min 32 characters if used locally. Generate: openssl rand -hex 32
AI_SETTINGS_SECRET=

# --- Optional integrations (unset = recording stubs / local defaults) ---
# SMTP_HOST=
# SMTP_FROM=
# SMTP_PASSWORD=
# ZALO_OA_ACCESS_TOKEN=
# MEILI_HOST=
# MEILI_API_KEY=

# Never set on Vercel Preview or Production:
# SEED_PASSWORD=
# DATABASE_PATH=
# TEST_HOOKS_ENABLED=
# TEST_HOOK_SECRET=
# CHECKOUT_SANDBOX_STUB=

# Required for GET /api/ready and cron drain.
CRON_SECRET=

# --- Supabase Storage scaffold (optional; not required for ready) ---
# Keep unset so Production stays on Postgres BYTEA (TASK-PLT-002).
# STORAGE_BACKEND=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=
