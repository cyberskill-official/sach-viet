# SachViet greenfield web — environment names only. Do not put real secrets here.
# See OPERATIONS.md for identity/bootstrap guidance. Copy to `.env` locally (gitignored).
# Cloud (Vercel Preview / Production): use .env.vercel.example + docs/deploy-vercel-supabase.md
# (set the same names in the Vercel UI — do not commit filled values).

# Session signing secret (min 32 characters). Required for auth cookies.
AUTH_SESSION_SECRET=

# Postgres connection URL (required for local Docker, CI, and Vercel+Supabase).
# Local Compose default: postgres://sachviet:sachviet@127.0.0.1:54329/sachviet
# Cloud: Supabase pooler URL on Vercel runtime; direct URL for npm run migrate (see deploy doc).
DATABASE_URL=

# Deprecated transitional CapRover/SQLite path. Prefer DATABASE_URL.
# DATABASE_PATH=

# First-admin bootstrap (only when the user store is empty). Prefer ADMIN_* (plain
# password hashed at runtime) plus AUTH_SESSION_SECRET. Fallback: BOOTSTRAP_ADMIN_*
# with a precomputed hash. ADMIN_* does not reset an existing admin password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Operator recovery when users already exist: set to 1 with ADMIN_EMAIL matching
# the existing admin row and ADMIN_PASSWORD as the new password; remove after login.
# ADMIN_EMAIL_SYNC=1
# ADMIN_PASSWORD_SYNC=1
# For Docker Compose env files, escape `$` in the hash as `$$` (see OPERATIONS.md Local Docker).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD_HASH=

# Stripe hosted checkout — sandbox/test only for this unlock (TASK-PAYMENTS-001).
# All three required for Stripe POST /api/checkout. Use sk_test_… only (sk_live_ refused).
STRIPE_SECRET_KEY=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
# Stripe webhook verification for POST /api/webhooks/stripe. Create via Dashboard test mode.
STRIPE_WEBHOOK_SECRET=
# Optional (hosted Checkout does not require it):
# STRIPE_PUBLISHABLE_KEY=

# PayPal Orders sandbox (TASK-PAYMENTS-001). PAYPAL_MODE must be sandbox (live refused).
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_RETURN_URL=
PAYPAL_CANCEL_URL=
# After registering webhook against Production URL:
# PAYPAL_WEBHOOK_ID=

# Email transport. When SMTP_HOST + SMTP_FROM are unset, email uses recording stubs.
SMTP_HOST=
SMTP_FROM=
SMTP_PASSWORD=
# Optional SMTP extras used by the adapter when present:
# SMTP_PORT=
# SMTP_USER=

# Zalo OA outbound. When unset, Zalo uses recording stubs.
ZALO_OA_ACCESS_TOKEN=

# Optional Meilisearch backend. When MEILI_HOST is unset, search stays local.
MEILI_HOST=
MEILI_API_KEY=
# Optional index override (defaults to catalog_products):
# MEILI_INDEX=

# Local seed only (never set on CapRover/Vercel/production). See OPERATIONS.md § Seeding.
# Prefer SEED_PASSWORD so the value is never written or printed; otherwise seed:local
# generates one into .seed-password (mode 0600).
# SEED_PASSWORD=
# SEED_PASSWORD_FILE=.seed-password

# Admin AI settings encryption (min 32 characters). Local/test only.
# Production GET/PUT /api/admin/ai-settings and POST /api/admin/ai/chat return 410.
# Generate with: openssl rand -hex 32
AI_SETTINGS_SECRET=

# Required for GET /api/ready and POST /api/cron/drain-order-comms.
CRON_SECRET=

# --- Supabase Storage (PKG-08 scaffold; optional; not required for ready) ---
# Default object backend remains Postgres BYTEA. Do not set STORAGE_BACKEND=supabase
# until the dedicated Storage package implements signed upload/download + scan.
# STORAGE_BACKEND=postgres
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=

# Local Playwright / `next start` smokes only (TASK-TEST-002). Never set on Vercel.
# TEST_HOOKS_ENABLED=1
# TEST_HOOK_SECRET=
# CHECKOUT_SANDBOX_STUB=1
